{
  "name": "pepkio-ph-buffer-solver",
  "version": "0.1.0",
  "description": "Henderson–Hasselbalch buffer solver with forward and reverse modes, bench recipes, buffer capacity, and cited pKa reference via the Pepkio Tools REST API.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "pepkio-ph-buffer-solver": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --exclude '**/integration.test.ts'",
    "test:integration": "vitest run integration.test.ts",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pepkio/pepkio-ph-buffer-solver-js.git"
  },
  "bugs": {
    "url": "https://github.com/pepkio/pepkio-ph-buffer-solver-js/issues"
  },
  "homepage": "https://www.pepkio.com/tools/ph-buffer-solver",
  "keywords": [
    "ph-buffer-solver",
    "buffer",
    "ph",
    "henderson-hasselbalch",
    "biochemistry",
    "lab",
    "buffer-capacity",
    "pka",
    "laboratory-calculator",
    "molecular-biology",
    "bioinformatics",
    "pepkio",
    "typescript",
    "node",
    "rest-api"
  ],
  "author": "Pepkio Team",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.10",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
